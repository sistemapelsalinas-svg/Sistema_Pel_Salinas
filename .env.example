# SGP Salinas — Variáveis de Ambiente Supabase & Next.js
# Para conectar ao seu Supabase na nuvem, preencha as variáveis abaixo:

NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# URL da Aplicação (usado na geração dos links de convite do WhatsApp)
NEXT_PUBLIC_APP_URL=https://sgp-salinas.vercel.app
